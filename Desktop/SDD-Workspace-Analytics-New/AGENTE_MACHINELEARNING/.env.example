# Chaves de API necessárias para o AgenteTutorML

# Tavily API Key (para raspagem e busca web de documentações oficiais)
TAVILY_API_KEY=tvly-your-tavily-key-here

# Provedor de LLM Gratuito (Groq) ou outros
GROQ_API_KEY=gsk_your_groq_key_here
GROQ_MODEL=llama-3.3-70b-versatile

GEMINI_API_KEY=your-gemini-api-key-here
OPENAI_API_KEY=your-openai-api-key-here

# Configuração do Banco Vetorial (Opcional - por padrão usa FAISS local)
PINECONE_API_KEY=
PINECONE_INDEX_NAME=tutorml-index

